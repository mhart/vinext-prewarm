{
  "name": "vinext-prewarm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.9.0"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:cdn": "VINEXT_CACHE_VARIANT=cdn vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:cdn": "wrangler dev --config dist/cdn/server/wrangler.json",
    "deploy:no-warm": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache --warm-cdn-certify",
    "deploy:stage": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache --warm-cdn-certify --warm-cdn-no-promote --verbose",
    "deploy:cdn:no-warm": "VINEXT_CACHE_VARIANT=cdn vinext-cloudflare deploy --config dist/cdn/server/wrangler.json",
    "deploy:cdn": "VINEXT_CACHE_VARIANT=cdn vinext-cloudflare deploy --config dist/cdn/server/wrangler.json --experimental-warm-cdn-cache --warm-cdn-certify",
    "deploy:cdn:stage": "VINEXT_CACHE_VARIANT=cdn vinext-cloudflare deploy --config dist/cdn/server/wrangler.json --experimental-warm-cdn-cache --warm-cdn-certify --warm-cdn-no-promote --verbose",
    "probe": "node scripts/probe.mjs"
  }
}
